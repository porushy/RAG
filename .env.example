# Copy this file to `.env` and paste your real key after the `=`.
# `.env` is listed in .gitignore and must never be committed.

# Gemini (used by pdf_study_assistant_3.py and rag_utils.make_gemini_llm).
# Get a free-tier key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-key-here

# Optional: open models on Groq (rag_utils.make_groq_llm / make_groq_llm_with_fallback).
# Get a free key at: https://console.groq.com  (API Keys -> Create API Key)
GROQ_API_KEY=your-key-here
